<StackPanel x:Class="PageLoginDstMode"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PCL"
             Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Stretch">
    <Border x:Name="PanAvatar" Width="88" Height="88" CornerRadius="44" HorizontalAlignment="Center"
            Background="{DynamicResource ColorBrush5}" ClipToBounds="True" />
    <!-- 皮肤入口：与正版登录页那颗皮肤按钮同一套样式（同款圆角胶囊 + 图标按钮），
         只在已登录时出现；上传要 accessToken，没登录点了也只会 401 -->
    <Border x:Name="PanSkin" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,8,0,0"
            CornerRadius="5" Background="{DynamicResource ColorBrush8}" Padding="10,3,9,3">
        <local:MyIconButton x:Name="BtnSkin" Height="24" LogoScale="1.08"
                            ToolTip="上传皮肤（右键可恢复默认）" ToolTipService.InitialShowDelay="50">
            <local:MyIconButton.ContextMenu>
                <ContextMenu>
                    <local:MyMenuItem Click="MenuResetSkin_Click" Header="恢复默认皮肤" />
                </ContextMenu>
            </local:MyIconButton.ContextMenu>
        </local:MyIconButton>
    </Border>
    <TextBlock x:Name="LabName" HorizontalAlignment="Center" FontSize="15" FontWeight="Bold"
               Margin="0,14,0,0" Text="QQ 登录" TextTrimming="CharacterEllipsis" MaxWidth="220" />
    <TextBlock x:Name="LabHint" HorizontalAlignment="Center" FontSize="12" Opacity="0.6"
               Margin="0,5,0,0" Text="未验证" TextTrimming="CharacterEllipsis" MaxWidth="240"
               TextWrapping="Wrap" TextAlignment="Center" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
        <local:MyButton x:Name="BtnVerify" Text="登录" Height="30" MinWidth="100" />
        <local:MyIconButton x:Name="BtnSecondary" Width="26" Height="26" LogoScale="0.75"
                            Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
    </StackPanel>
</StackPanel>
