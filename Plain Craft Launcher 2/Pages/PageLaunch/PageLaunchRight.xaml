<local:MyPageRight x:Class="PageLaunchRight"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:behaviors="clr-namespace:PCL.Controls.Behaviors"
    xmlns:local="clr-namespace:PCL" PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Name="PanMain" Margin="25,25,25,10" Grid.IsSharedSizeScope="True">
            <local:MyHint x:Name="PanHint" RelativeSetup="HintSnapshot" Theme="Blue" CanClose="True" Margin="0,0,0,15"
                          Text="快照版 PCL 包含尚未正式发布的测试功能，仅限赞助者自己使用。&#xa;请不要随意发给其他人，或是用来制作整合包哦！" />
            <!-- PCL 原有的主页自定义内容：位置在机器人卡片之前，保证自定义主页仍是首屏主体 -->
            <StackPanel x:Name="PanCustom">
            </StackPanel>
            <StackPanel x:Name="PanDstCards">
            <local:MyCard Margin="0,0,0,15" Title="服务器状态" x:Name="CardDstServers">
                <StackPanel Margin="25,40,25,20">
                    <Grid>
                        <TextBlock x:Name="LabDstSummary" Text="正在获取服务器列表……" VerticalAlignment="Center" />
                        <TextBlock x:Name="LabDstUpdate" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="12" Opacity="0.55" Text="" />
                    </Grid>
                    <StackPanel x:Name="PanDstServers" Margin="0,10,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <local:MyButton x:Name="BtnDstRefresh" Text="刷新" Height="32" MinWidth="104" Margin="0,0,10,0" />
                        <local:MyButton x:Name="BtnDstJoin" Text="加入群" Height="32" MinWidth="104" ColorType="Highlight" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="群公告" x:Name="CardDstReport">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock x:Name="LabDstReportName" FontSize="12" Opacity="0.55" Margin="0,0,0,8" Text="" />
                    <TextBox x:Name="LabDstReport" TextWrapping="Wrap" FontSize="13" IsReadOnly="True"
                             Background="Transparent" BorderThickness="0" Margin="0,0,0,0"
                             VerticalAlignment="Top" MaxHeight="180" VerticalScrollBarVisibility="Auto"
                             Foreground="{DynamicResource ColorBrush1}" />
                    <local:MyButton x:Name="BtnDstReportAll" Text="查看全部公告" Height="30" MinWidth="124"
                                    HorizontalAlignment="Left" Margin="0,12,0,0" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="帝释天机器人" x:Name="CardDstBot">
                <Grid Margin="25,40,25,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="DstBotName" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="服务" VerticalAlignment="Center" Margin="0,0,20,0" />
                    <TextBlock x:Name="LabBotService" Grid.Column="1" VerticalAlignment="Center" Text="帝释天预设服务" />
                    <TextBlock Grid.Row="1" Text="群" VerticalAlignment="Center" Margin="0,0,20,0" />
                    <TextBlock x:Name="LabBotGroup" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Text="—" />
                    <TextBlock x:Name="LabBotBind" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"
                               FontSize="12" Opacity="0.55" Margin="12,0,0,0" Text="未绑定 QQ" />
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,14,0,0">
                        <local:MyButton x:Name="BtnDstBotBind" Text="绑定 QQ" Height="32" MinWidth="104" Margin="0,0,10,0" />
                        <local:MyButton x:Name="BtnDstBotMore" Text="机器人设置" Height="32" MinWidth="104" />
                    </StackPanel>
                </Grid>
            </local:MyCard>
            </StackPanel>
            <local:MyCard Margin="0,0,0,15" Title="启动日志" x:Name="PanLog">
                <local:MyTextBox x:Name="LabLog" Margin="15,34,15,13" Padding="0,4" IsReadOnly="True" IsUndoEnabled="False"
                         AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" HasBackground="False"
                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" />
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
