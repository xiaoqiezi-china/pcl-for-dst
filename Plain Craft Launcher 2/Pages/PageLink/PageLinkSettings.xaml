<local:MyPageRight
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" x:Class="PageLinkSettings"
             d:DesignWidth="800" d:DesignHeight="800" PanScroll="PanBack">
    <Grid>
        <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
            <StackPanel Margin="25,10,25,10" x:Name="PanMain">
                <local:MyCard Margin="0,15,0,15" Title="联机节点">
                    <StackPanel Margin="25,42,25,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="选择优先使用的节点。选「自动」会先测速再挑最快的。"
                                       FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" />
                            <local:MyButton Grid.Column="1" x:Name="BtnNodeRefresh" Text="刷新" Padding="13,4" MinWidth="70" Margin="12,0,0,0" />
                        </Grid>
                        <local:MyComboBox x:Name="CmbLinkNode" Height="32" Margin="0,12,0,0" />
                        <TextBlock Text="自定义节点" Margin="0,18,0,8" />
                        <local:MyTextBox x:Name="TextCustomNode" Height="32"
                                         HintText="例如 tcp://1.2.3.4:11010，多个用 ，， 分隔" />
                        <TextBlock Margin="0,8,0,0" FontSize="11" Opacity="0.45" TextWrapping="Wrap"
                                   Text="填写后优先使用这里的地址，留空则使用上方选择的节点。未知节点可能记录你的连接信息，请只连接信任的地址。" />
                    </StackPanel>
                </local:MyCard>

                <local:MyCard Margin="0,0,0,15" Title="更多">
                    <StackPanel Margin="25,42,25,20">
                        <TextBlock FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrushGray2}"
                                   Text="「延迟优先 / 优先直连」模式仍在「设置 → 联机」里。修改后下次创建或加入房间时生效。" />
                        <local:MyButton x:Name="BtnOpenLinkSetup" Text="打开完整联机设置" MinWidth="150"
                                        Padding="13,5" Margin="0,12,0,0" HorizontalAlignment="Left" />
                    </StackPanel>
                </local:MyCard>
            </StackPanel>
        </local:MyScrollViewer>
    </Grid>
</local:MyPageRight>