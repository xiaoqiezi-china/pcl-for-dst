<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageSetupDst"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10" Grid.IsSharedSizeScope="True">
            <local:MyCard Margin="0,15" Title="帝释天机器人">
                <Grid Margin="25,40,25,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="DstSetupName" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="服务" Margin="0,0,25,0" />
                    <TextBlock x:Name="LabDstService" Grid.Column="1" VerticalAlignment="Center" Text="帝释天预设服务" />
                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="连接" Margin="0,0,25,0" />
                    <TextBlock x:Name="LabDstStatus" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Text="未检测" />
                    <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="QQ 群" Margin="0,0,25,0" />
                    <TextBlock x:Name="LabDstGroup" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Text="—" />
                    <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="QQ 绑定" Margin="0,0,25,0" />
                    <TextBlock x:Name="LabDstQq" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Text="未绑定" />
                    <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,14,0,0">
                        <local:MyButton x:Name="BtnDstTest" Text="测试连接" Height="32" MinWidth="104" Margin="0,0,10,0" />
                        <local:MyButton x:Name="BtnDstJoinGroup" Text="加入群" Height="32" MinWidth="104" Margin="0,0,10,0" ColorType="Highlight" />
                        <local:MyButton x:Name="BtnDstQq" Text="绑定 QQ" Height="32" MinWidth="104" />
                    </StackPanel>
                </Grid>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="本地数据">
                <StackPanel Margin="25,40,25,20">
                    <Grid>
                        <TextBlock x:Name="LabCacheInfo" VerticalAlignment="Center" Text="正在统计……" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <local:MyButton x:Name="BtnCacheFolder" Text="打开目录" Height="28" MinWidth="88" Margin="0,0,8,0" />
                            <local:MyButton x:Name="BtnCacheClear" Text="清理缓存" Height="28" MinWidth="88" />
                        </StackPanel>
                    </Grid>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.6" Margin="0,8,0,0"
                               Text="聊天记录会加密？不会——它就是明文 JSON，存在 PCL\DstChat\ 下，按群一个文件，最多保留 300 条。清理后历史消息需要重新从服务器拉取。" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="启动器更新">
                <StackPanel Margin="25,40,25,20">
                    <StackPanel Orientation="Horizontal">
                        <local:MyButton x:Name="BtnCheckUpdate" Text="检查启动器更新" Height="30" MinWidth="120" />
                        <TextBlock x:Name="LabUpdateState" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.65" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>            <local:MyCard Margin="0,0,0,15" Title="主页展示">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock Text="勾选控制是否显示，↑ ↓ 调整上下顺序" FontSize="12" Opacity="0.6" Margin="0,0,0,12" />
                    <StackPanel x:Name="PanHomeOrder" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="QQ 群">
                <StackPanel Margin="25,40,25,20">
                    <Grid>
                        <TextBlock x:Name="LabDstGroupTip" VerticalAlignment="Center" Text="正在获取群列表……" />
                        <local:MyButton x:Name="BtnDstGroupRefresh" Text="刷新列表" Height="28" MinWidth="96" HorizontalAlignment="Right" />
                    </Grid>
                    <StackPanel x:Name="PanDstGroups" Margin="0,10,0,0" />
                    <TextBlock x:Name="LabDstGroupInfo" TextWrapping="Wrap" FontSize="12.5" LineHeight="20" Margin="0,12,0,0" Opacity="0.8" Text="" />
                    <TextBlock x:Name="LabDstGroupReport" TextWrapping="Wrap" FontSize="12.5" LineHeight="20" Margin="0,6,0,0" Opacity="0.65" Text="" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="QQ 绑定说明">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="21"
                               Text="绑定流程：填 QQ 号 → 帝释天机器人在群里 @ 你并发送确认消息 → 5 分钟内在群里回复 OK 即完成绑定。&#xa;同意可用 OK / ok / 是 / yes，或直接回复那条消息；输入 td 屏蔽本应用，输入 never 拒绝一切绑定。&#xa;绑定成功后服务端会返回一个长期有效的 user_key，启动器把它加密保存在本机注册表里，界面只显示掩码。" />
                    <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="21" Margin="0,10,0,0"
                               Text="群内可用命令：&#xa;/bind list —— 查看已绑定的应用（不显示令牌）&#xa;/bind unbind [序号] —— 按序号解绑&#xa;/bind never —— 不再接受任何绑定&#xa;/bind accept —— 取消 never" />
                    <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="21" Margin="0,10,0,0" Opacity="0.75"
                               Text="限频：成功一次后 5 分钟内不能再发起；失败 1 分钟内最多 5 次；同一 IP 每天最多 10 次成功（成功即产生实际开销）。" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="连接说明">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="21"
                               Text="启动器默认使用内置的帝释天服务，地址与凭证已写在程序内，不需要也不建议手动填写。&#xa;接口有频率限制：同一 IP 每分钟最多 5 次请求，启动器已自动排队，正常情况下不会触发 429。" />
                    <TextBlock x:Name="LabDstQuota" TextWrapping="Wrap" FontSize="13" LineHeight="21" Margin="0,10,0,0"
                               Text="本地剩余配额：—" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard x:Name="CardDstCustom" Margin="0,0,0,15" Title="自定义服务" CanSwap="True">
                <StackPanel Margin="25,40,25,20">
                    <local:MyCheckBox x:Name="CheckDstUseCustom" Text="改用自定义服务（自建机器人，需自己提供地址与令牌）"
                                      Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="DstSetupName2" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="API 地址" Margin="0,0,25,0" />
                        <local:MyTextBox x:Name="TextDstApi" Grid.Column="1" MaxLength="300" />
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="令牌 Token" Margin="0,0,25,0" />
                        <local:MyTextBox x:Name="TextDstToken" Grid.Row="2" Grid.Column="1" MaxLength="200" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <local:MyButton x:Name="BtnDstSave" Text="保存配置" Height="32" MinWidth="104" ColorType="Highlight" />
                        <TextBlock x:Name="LabDstSaveTip" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12" Opacity="0.6" Text="保存后立即生效" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
