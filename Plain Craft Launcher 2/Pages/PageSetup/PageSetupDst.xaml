<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageSetupDst"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10" Grid.IsSharedSizeScope="True">

            <!-- 源状态：决定启动器从哪里取更新与预设 -->
            <local:MyCard Margin="0,15" Title="源状态">
                <StackPanel Margin="25,40,25,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Ellipse x:Name="DotGithub" Width="9" Height="9" Margin="0,0,9,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <TextBlock x:Name="LabGithub" Grid.Column="1" VerticalAlignment="Center" Text="GitHub" />
                        <Ellipse x:Name="DotGitee" Grid.Row="1" Width="9" Height="9" Margin="0,0,9,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <TextBlock x:Name="LabGitee" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Text="Gitee" />
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" TextWrapping="Wrap" FontSize="12" Opacity="0.6" Margin="0,8,0,0"
                                   Text="这里的状态决定启动器检查更新与拉取预设时走哪个源。" />
                    </Grid>
                </StackPanel>
            </local:MyCard>

            <!-- 云信息：随「常规 / 启用」两种状态切换内容 -->
            <local:MyCard Margin="0,0,0,15" Title="云信息">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock x:Name="LabCloudOffline" TextWrapping="Wrap" FontSize="13" LineHeight="21" Visibility="Collapsed"
                               Text="当前没有连接远程服务器，启动器处于常规模式。" />
                    <Grid x:Name="PanCloudOnline">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="DstSetupName" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="延迟" Margin="0,0,25,0" />
                        <TextBlock x:Name="LabCloudLatency" Grid.Column="1" VerticalAlignment="Center" Text="—" />
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="QQ 群" Margin="0,0,25,0" />
                        <TextBlock x:Name="LabDstGroup" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Text="—" />
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="服务状态" Margin="0,0,25,0" />
                        <TextBlock x:Name="LabDstStatus" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Text="未检测" />
                        <TextBlock x:Name="LabDstQq" Grid.Row="3" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.8"
                                   Text="未绑定" />
                    </Grid>
                </StackPanel>
            </local:MyCard>

            <!-- 服务器设置：预设 / 自定义二选一，下面一块信息区 -->
            <local:MyCard Margin="0,0,0,15" Title="服务器设置">
                <StackPanel Margin="25,40,25,20">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <local:MyRadioBox x:Name="RadioDstPreset" Text="预设" Height="22" Margin="0,0,25,0" />
                        <local:MyRadioBox x:Name="RadioDstCustom" Text="自定义" Height="22" />
                    </StackPanel>

                    <!-- 预设：选一个再看清楚它的地址与群号 -->
                    <StackPanel x:Name="PanDstPreset">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:MyComboBox x:Name="CmbDstPreset" Height="30" />
                            <local:MyButton x:Name="BtnDstPresetRefresh" Grid.Column="1" Text="刷新" Height="30" MinWidth="72" Margin="10,0,0,0" />
                        </Grid>
                        <local:MyHint x:Name="HintDstTrust" Margin="0,12,0,0" Theme="Yellow"
                                     Text="请确认下面的服务地址是你信任的服务器。预设来自远程列表，启动器只能保证它没被本地改动，无法替你判断服务器本身是否可信。" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="DstSetupName" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="服务地址" Margin="0,0,25,0" />
                            <TextBlock x:Name="LabDstPresetUrl" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="—" />
                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="QQ 群" Margin="0,0,25,0" />
                            <TextBlock x:Name="LabDstPresetQq" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Text="—" />
                            <TextBlock x:Name="LabDstPresetNote" Grid.Row="2" Grid.ColumnSpan="2" TextWrapping="Wrap" FontSize="12" Opacity="0.6" Margin="0,6,0,0" />
                        </Grid>
                        <TextBlock x:Name="LabDstPresetState" FontSize="12" Opacity="0.6" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="正在获取预设列表……" />
                    </StackPanel>

                    <!-- 自定义：自己填地址与令牌 -->
                    <StackPanel x:Name="PanDstCustomInput" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="DstSetupName" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="30" />
                            </Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="API 地址" Margin="0,0,25,0" />
                            <local:MyTextBox x:Name="TextDstApi" Grid.Column="1" MaxLength="300" />
                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="令牌 Token" Margin="0,0,25,0" />
                            <local:MyTextBox x:Name="TextDstToken" Grid.Row="2" Grid.Column="1" MaxLength="200" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <local:MyButton x:Name="BtnDstSave" Text="保存配置" Height="32" MinWidth="104" ColorType="Highlight" />
                            <TextBlock x:Name="LabDstSaveTip" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12" Opacity="0.6" Text="保存后立即生效" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 群列表：选了服务之后才有意义 -->
                    <StackPanel x:Name="PanDstGroupsArea" Margin="0,14,0,0">
                        <Grid>
                            <TextBlock x:Name="LabDstGroupTip" VerticalAlignment="Center" Text="正在获取群列表……" />
                            <local:MyButton x:Name="BtnDstGroupRefresh" Text="刷新列表" Height="26" MinWidth="88" HorizontalAlignment="Right" />
                        </Grid>
                        <StackPanel x:Name="PanDstGroups" Margin="0,8,0,0" />
                        <TextBlock x:Name="LabDstGroupInfo" TextWrapping="Wrap" FontSize="12" LineHeight="19" Margin="0,8,0,0" Opacity="0.8" Text="" />
                        <TextBlock x:Name="LabDstGroupReport" TextWrapping="Wrap" FontSize="12" LineHeight="19" Margin="0,4,0,0" Opacity="0.6" Text="" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <local:MyButton x:Name="BtnDstTest" Text="测试连接" Height="32" MinWidth="104" Margin="0,0,10,0" />
                        <local:MyButton x:Name="BtnDstJoinGroup" Text="加入群" Height="32" MinWidth="104" Margin="0,0,10,0" ColorType="Highlight" />
                        <local:MyButton x:Name="BtnDstQq" Text="绑定 QQ" Height="32" MinWidth="104" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>

            <!-- 本地数据 -->
            <local:MyCard Margin="0,0,0,15" Title="本地数据">
                <StackPanel Margin="25,40,25,20">
                    <Grid>
                        <TextBlock x:Name="LabCacheInfo" VerticalAlignment="Center" Text="正在统计……" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <local:MyButton x:Name="BtnCacheFolder" Text="打开目录" Height="28" MinWidth="88" Margin="0,0,8,0" />
                            <local:MyButton x:Name="BtnCacheClear" Text="清理缓存" Height="28" MinWidth="88" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </local:MyCard>

            <!-- 检查更新：与源状态呼应，平时收在下面 -->
            <local:MyCard Margin="0,0,0,15" Title="启动器更新">
                <StackPanel Margin="25,40,25,20">
                    <StackPanel Orientation="Horizontal">
                        <local:MyButton x:Name="BtnCheckUpdate" Text="检查启动器更新" Height="30" MinWidth="120" />
                        <TextBlock x:Name="LabUpdateState" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.65" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
