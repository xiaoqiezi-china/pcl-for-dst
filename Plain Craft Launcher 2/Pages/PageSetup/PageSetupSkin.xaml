<local:MyPageRight x:Class="PageSetupSkin"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Margin="25,25,25,10" x:Name="PanMain">
            <local:MyCard Title="皮肤包" Margin="0,0,0,15">
                <StackPanel Margin="25,38,20,18">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" FontSize="12" Opacity="0.65"
                               Text="皮肤包可以改按钮与卡片的样式、圆角、配色。它只覆盖你声明的项目，没写的仍跟随下方主题色设置。皮肤放在 PCL\Skins 下，一个皮肤一个文件夹，内含 skin.json。" />
                    <WrapPanel x:Name="PanActions" Margin="0,0,0,6">
                        <local:MyButton x:Name="BtnImport" Text="导入皮肤" Height="32" MinWidth="104" Margin="0,0,10,8" ColorType="Highlight" />
                        <local:MyButton x:Name="BtnCreateTemplate" Text="新建模板" Height="32" MinWidth="104" Margin="0,0,10,8" />
                        <local:MyButton x:Name="BtnOpenFolder" Text="打开皮肤目录" Height="32" MinWidth="120" Margin="0,0,10,8" />
                    </WrapPanel>
                </StackPanel>
            </local:MyCard>
            <local:MyCard x:Name="CardList" Title="已安装" Margin="0,0,0,15">
                <StackPanel Margin="25,38,20,18">
                    <StackPanel x:Name="PanList" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
