<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageInstanceFavorites"
    PanScroll="PanBack">
    <Grid>
        <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
            <StackPanel x:Name="PanMain" Margin="25,10,25,10" Grid.IsSharedSizeScope="True">
                <local:MySearchBox Margin="0,15" HintText="搜索收藏的名称 / 描述" x:Name="SearchBox" />

                <local:MyCard Margin="0,0,0,15" x:Name="CardManage">
                    <Grid Margin="15,15,0,15" Height="35">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnInstall" Grid.Column="0" MinWidth="110" Text="安装到本版本"
                                        Padding="13,0" Margin="0,0,15,0" HorizontalAlignment="Left" ColorType="Highlight" />
                        <local:MyButton x:Name="BtnImport" Grid.Column="1" MinWidth="110" Text="导入分享码"
                                        Padding="13,0" Margin="0,0,15,0" HorizontalAlignment="Left" />
                        <local:MyButton x:Name="BtnSelectAll" Grid.Column="2" MinWidth="110" Text="全选"
                                        Padding="13,0" Margin="0,0,15,0" HorizontalAlignment="Left" />
                    </Grid>
                </local:MyCard>
                <TextBlock Text="左键点击勾选，右键或悬停后的「详情」按钮进入资源详情页。"
                           FontSize="11" Opacity="0.45" TextWrapping="Wrap" Margin="2,0,0,6" />
                <local:MyCard x:Name="CardList" Margin="0,0,0,15" Title=" " MinHeight="55">
                    <StackPanel x:Name="PanFilter" Margin="15,13,0,0" Orientation="Horizontal"
                                VerticalAlignment="Top" HorizontalAlignment="Left" Height="28">
                        <local:MyRadioButton Tag="1" ColorType="Highlight" VerticalAlignment="Center" Margin="2,0"
                                             Text="Mod" x:Name="BtnFilterMod" Checked="True" />
                        <local:MyRadioButton Tag="2" ColorType="Highlight" VerticalAlignment="Center" Margin="2,0"
                                             Text="整合包" x:Name="BtnFilterModPack" />
                        <local:MyRadioButton Tag="16" ColorType="Highlight" VerticalAlignment="Center" Margin="2,0"
                                             Text="数据包" x:Name="BtnFilterDataPack" />
                        <local:MyRadioButton Tag="4" ColorType="Highlight" VerticalAlignment="Center" Margin="2,0"
                                             Text="资源包" x:Name="BtnFilterResourcePack" />
                        <local:MyRadioButton Tag="8" ColorType="Highlight" VerticalAlignment="Center" Margin="2,0"
                                             Text="光影包" x:Name="BtnFilterShader" />
                    </StackPanel>
                    <StackPanel x:Name="PanList" Margin="20,48,18,22" VerticalAlignment="Top" />
                </local:MyCard>
            </StackPanel>
        </local:MyScrollViewer>

        <!-- 多选操作条：有选中项时才出现 -->
        <local:MyCard x:Name="CardSelect" Visibility="Collapsed" Opacity="0"
                      HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="25,25,25,0" UseAnimation="False">
            <TextBlock x:Name="LabSelect" Text="" HorizontalAlignment="Center" VerticalAlignment="Top"
                       Margin="9" Foreground="{DynamicResource ColorBrush2}" />
            <StackPanel Orientation="Horizontal" Margin="5,28,5,5">
                <local:MyIconTextButton x:Name="BtnSelectInstall" Text="安装" LogoScale="1" />
                <local:MyIconTextButton x:Name="BtnSelectShare" Text="分享" LogoScale="1" />
                <local:MyIconTextButton x:Name="BtnSelectDelete" Text="取消收藏" LogoScale="0.96" />
                <local:MyIconTextButton x:Name="BtnSelectCancel" Text="取消选择" LogoScale="0.8" />
            </StackPanel>
        </local:MyCard>
    </Grid>
</local:MyPageRight>
