<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageGroupInfo">
    <Grid Margin="25,0,25,0">
        <!-- 离线模式：整页只留一个上线按钮 -->
        <Border x:Name="PanOffline" Background="Transparent" Visibility="Collapsed">
            <local:MyButton x:Name="BtnGoOnlineChat" Text="上线" Width="200" Height="44"
                            HorizontalAlignment="Center" VerticalAlignment="Center" ColorType="Highlight" />
        </Border>
        <local:MyCard Margin="0,15,0,15" Title="群消息" VerticalAlignment="Stretch" x:Name="CardChat">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 悬浮置顶的头部 -->
                <Grid Grid.Row="0" Margin="25,40,25,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LabChatTitle" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Text="正在获取群消息……" />
                    <TextBlock x:Name="LabChatQuota" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,10,0"
                               FontSize="11.5" Opacity="0.5" Text="" />
                    <local:MyButton x:Name="BtnChatRefresh" Grid.Column="2" Text="刷新" Height="28" MinWidth="80" />
                </Grid>

                <!-- 卡片内部独立滚动区：用虚拟化面板，只有可见的消息才真正创建控件 -->
                <local:MyScrollViewer x:Name="PanChatScroll" Grid.Row="1" Margin="0,0,0,0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="True" ScrollChanged="PanChatScroll_ScrollChanged">
                    <ItemsControl x:Name="PanChat" Margin="25,6,17,18"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:DstChatRow Margin="0,0,0,8" HorizontalContentAlignment="Stretch" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </local:MyScrollViewer>
            </Grid>
        </local:MyCard>
    </Grid>
</local:MyPageRight>
