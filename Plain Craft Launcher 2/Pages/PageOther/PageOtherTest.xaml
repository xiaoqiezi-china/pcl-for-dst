<local:MyPageRight x:Class="PageOtherTest"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:PCL"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    PanScroll="PanBack">
    <local:MyPageRight.Resources>
        <!-- 进度/跳转条：细圆角轨道 + 圆形滑块 -->
        <Style x:Key="SeekSlider" TargetType="Slider">

            <!-- 允许点轨道直接跳过去，不加这个只能拖滑块 -->

            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="18" Background="Transparent">
                            <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                                    Background="{DynamicResource ColorBrushGray4}" Opacity="0.4" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <!-- 已播放的一段：用强调色铺出来 -->
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                                                        Background="{DynamicResource ColorBrush3}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="8" Background="{DynamicResource ColorBrush3}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 竖向音量条，跟进度条同一套外观 -->

        <Style x:Key="VolumeSlider" TargetType="Slider">

            <Setter Property="Orientation" Value="Vertical" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Slider">

                        <Grid Width="18" Height="110" Background="Transparent">

                            <Border Width="6" CornerRadius="3" HorizontalAlignment="Center"

                                    Background="{DynamicResource ColorBrushGray4}" Opacity="0.4" />

                            <Track x:Name="PART_Track" Orientation="Vertical">

                                <Track.DecreaseRepeatButton>

                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">

                                        <RepeatButton.Template>

                                            <ControlTemplate TargetType="RepeatButton">

                                                <Border Width="6" CornerRadius="3" HorizontalAlignment="Center"

                                                        Background="{DynamicResource ColorBrush3}" />

                                            </ControlTemplate>

                                        </RepeatButton.Template>

                                    </RepeatButton>

                                </Track.DecreaseRepeatButton>

                                <Track.IncreaseRepeatButton>

                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False" />

                                </Track.IncreaseRepeatButton>

                                <Track.Thumb>

                                    <Thumb Width="16" Height="16">

                                        <Thumb.Template>

                                            <ControlTemplate TargetType="Thumb">

                                                <Border CornerRadius="8" Background="{DynamicResource ColorBrush3}" />

                                            </ControlTemplate>

                                        </Thumb.Template>

                                    </Thumb>

                                </Track.Thumb>

                            </Track>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>    </local:MyPageRight.Resources>

    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Margin="25,0,25,0">

            <local:MyCard Margin="0,15,0,15" Title="音乐播放器">
                <Grid Margin="25,34,25,16" Height="290">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>

                    <!-- 顶部：音符 + 曲名 + 上一首/播放/下一首 + 设置 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Path x:Name="PathMusicNote" Grid.Column="0" Width="26" Height="26" Stretch="Uniform"
                              VerticalAlignment="Center" Fill="{DynamicResource ColorBrush3}" />

                        <TextBlock x:Name="LabTrack" Grid.Column="1" Text="未在播放" FontSize="18" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="14,0,14,0" TextTrimming="CharacterEllipsis" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="BtnPrev" Width="30" Height="30" CornerRadius="15" Background="Transparent"
                                    Cursor="Hand" ToolTip="上一首">
                                <Path x:Name="PathPrev" Width="13" Height="13" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Fill="{DynamicResource ColorBrush3}" />
                            </Border>
                            <Border x:Name="BtnPlay" Width="34" Height="34" CornerRadius="17" Margin="12,0"
                                    Background="{DynamicResource ColorBrush3}" Cursor="Hand" ToolTip="播放">
                                <Path x:Name="PathPlay" Width="13" Height="13" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Fill="{DynamicResource ColorBrush1}" />
                            </Border>
                            <Border x:Name="BtnNext" Width="30" Height="30" CornerRadius="15" Background="Transparent"
                                    Cursor="Hand" ToolTip="下一首">
                                <Path x:Name="PathNext" Width="13" Height="13" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Fill="{DynamicResource ColorBrush3}" />
                            </Border>
                        </StackPanel>

                        <Border x:Name="BtnVolume" Grid.Column="3" Width="30" Height="30" CornerRadius="15"

                                Background="Transparent" Cursor="Hand" ToolTip="音量"

                                Margin="14,0,0,0" VerticalAlignment="Top">

                            <Grid Width="16" Height="16">

                                <Path Fill="{DynamicResource ColorBrush3}" Stretch="Uniform"

                                      Data="M2,8 L6,8 L11,3 L11,17 L6,12 L2,12 Z" />

                                <Path Stroke="{DynamicResource ColorBrush3}" StrokeThickness="1.6"

                                      Stretch="Uniform" Margin="10,4,0,4"

                                      Data="M1,3 A5,5 0 0 1 1,11" />

                            </Grid>

                        </Border>

                        <local:MyIconButton x:Name="BtnMusicSetup" Grid.Column="4" Width="28" Height="28"

                                            LogoScale="0.85" ToolTip="播放器设置" Margin="8,0,0,0"

                                            VerticalAlignment="Top" />

                        <Popup x:Name="PopupVolume" PlacementTarget="{Binding ElementName=BtnVolume}"

                               Placement="Top" StaysOpen="False" AllowsTransparency="True"

                               HorizontalOffset="0" VerticalOffset="6">

                            <Border CornerRadius="8" Padding="10,12" Background="{DynamicResource ColorBrush7}"

                                    BorderThickness="1" BorderBrush="{DynamicResource ColorBrush6}">

                                <StackPanel>

                                    <Slider x:Name="SliderVolume" Style="{StaticResource VolumeSlider}"

                                            Minimum="0" Maximum="100" Value="50" />

                                    <TextBlock x:Name="LabVolume" Text="50%" FontSize="11" Opacity="0.6"

                                               HorizontalAlignment="Center" Margin="0,6,0,0" />

                                </StackPanel>

                            </Border>

                        </Popup>
                    </Grid>

                    <!-- 进度：可拖动跳转 -->
                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SliderSeek" Style="{StaticResource SeekSlider}"
                                Minimum="0" Maximum="1000" VerticalAlignment="Center" />
                        <TextBlock x:Name="LabTime" Grid.Column="1" Text="0:00 / 0:00" FontSize="11"
                                   Opacity="0.5" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>

                    <!-- 列表 -->
                    <Border Grid.Row="2" Margin="0,14,0,0" CornerRadius="6" Padding="6"
                            BorderThickness="1" BorderBrush="{DynamicResource ColorBrush6}"
                            Background="{DynamicResource ColorBrush7}">
                        <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="PanMusicList" />
                        </local:MyScrollViewer>
                    </Border>
                </Grid>
            </local:MyCard>

            <!-- 下载器：输入直链，交给多线程下载引擎 -->
            <local:MyCard Margin="0,0,0,15" Title="下载器">
                <Grid Margin="25,34,25,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:MyTextBox x:Name="TextDlUrl" Grid.Column="0" Height="30" MaxHeight="30"
                                         HintText="粘贴下载直链，例如 https://example.com/file.zip" />
                        <local:MyButton x:Name="BtnDlStart" Grid.Column="1" Margin="10,0,0,0" Height="30"
                                        MinWidth="96" Text="开始下载" ColorType="Highlight" />
                        <local:MyButton x:Name="BtnDlFolder" Grid.Column="2" Margin="10,0,0,0" Height="30"
                                        MinWidth="118" Text="打开下载文件夹" />
                    </Grid>
                    <TextBlock x:Name="LabDlState" Grid.Row="1" Margin="0,10,0,0" FontSize="12" Opacity="0.7"
                               TextWrapping="Wrap" Text="使用多线程下载能力下载自定义文件。" />
                </Grid>
            </local:MyCard>
            <!-- 汉化工具：独立副程序，体积大，按需下载 -->
            <local:MyCard Margin="0,0,0,15" Title="汉化工具">
                <StackPanel Margin="25,34,25,18">
                    <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,14"
                               Text="自动解析本地化文本并提供AI工作区进行翻译操作。支持并发LLM,机翻。" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="I18nName" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="监听端口" VerticalAlignment="Center" Margin="0,0,20,0" />
                        <local:MyTextBox x:Name="TextI18nPort" Grid.Column="1" Height="30" MaxHeight="30"
                                         HintText="留空则随机分配一个空闲端口" />
                        <TextBlock Grid.Row="2" Text="工作目录" VerticalAlignment="Center" Margin="0,0,20,0" />
                        <Grid Grid.Row="2" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:MyTextBox x:Name="TextI18nFolder" Height="30" MaxHeight="30" IsReadOnly="True"
                                             HintText="选择含 mods、kubejs 的那个文件夹" />
                            <local:MyButton x:Name="BtnI18nPick" Grid.Column="1" Margin="10,0,0,0" Height="30"
                                            MinWidth="88" Text="选择文件夹" />
                        </Grid>
                    </Grid>
                    <WrapPanel Margin="0,4,0,0">
                        <local:MyButton x:Name="BtnI18nStart" MinWidth="120" Height="34" Padding="13,0" Margin="0,0,12,0"
                                        Text="开启" ColorType="Highlight" />
                        <local:MyButton x:Name="BtnI18nDownload" MinWidth="140" Height="34" Padding="13,0" Margin="0,0,12,0"
                                        Text="下载此程序" />
                        <local:MyButton x:Name="BtnI18nStop" MinWidth="100" Height="34" Padding="13,0" Margin="0,0,12,0"
                                        Text="关闭" Visibility="Collapsed" />
                        <local:MyButton x:Name="BtnI18nOpen" MinWidth="120" Height="34" Padding="13,0"
                                        Text="打开网页" Visibility="Collapsed" />
                    </WrapPanel>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LabI18nState" Grid.Column="0" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Text="" />
                        <TextBlock x:Name="LabI18nVersion" Grid.Column="1" Margin="12,0,0,0" FontSize="11.5"
                                   MaxWidth="210" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Bottom" Text="" />
                    </Grid>
                </StackPanel>
            </local:MyCard>

            <!-- DeepseekCE：Deepseek 桌面客户端的内置安装入口，同时也是「询问 AI」的被调用方。
                 安装包从 GitHub Release 取，优先走镜像源；装没装以卸载注册表项为准。 -->
            <local:MyCard Margin="0,0,0,15" Title="DeepseekCE" x:Name="CardDsc">
                <Grid Margin="25,34,25,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Width="46" Height="46" CornerRadius="10"
                            VerticalAlignment="Top" Background="{DynamicResource ColorBrush7}"
                            BorderThickness="1" BorderBrush="{DynamicResource ColorBrush6}">
                        <Image Source="/Plain Craft Launcher 2;component/Images/Heads/deepseek.png" Margin="5" />
                    </Border>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Text="Deepseek CE桌面客户端" FontSize="13.5" FontWeight="Bold" Margin="0,1,0,0" />
                        <TextBlock Margin="0,6,0,0" FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                   Text="从Github中获取最新的版本" />
                        <WrapPanel Margin="0,14,0,0">
                            <local:MyButton x:Name="BtnDscInstall" MinWidth="96" Height="32" Padding="13,0" Margin="0,0,10,0"
                                            Text="安装" ColorType="Highlight" />
                            <local:MyButton x:Name="BtnDscUninstall" MinWidth="96" Height="32" Padding="13,0" Margin="0,0,10,0"
                                            Text="卸载" Visibility="Collapsed" />
                            <local:MyButton x:Name="BtnDscOpen" MinWidth="96" Height="32" Padding="13,0" Margin="0,0,10,0"
                                            Text="打开" Visibility="Collapsed" />
                            <local:MyButton x:Name="BtnDscUpdate" MinWidth="96" Height="32" Padding="13,0"
                                            Text="更新" ColorType="Highlight" Visibility="Collapsed" />
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
                        <local:MyCheckBox x:Name="CheckDscEnabled" Height="26" local:SettingService.Key="DstAiEnabled"
                                          Text="是否启用 DeepseekCE"
                                          ToolTip="开启后，启动器里的「询问 AI」「发送给 AI」「AI总结」等按钮才能用。" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="DscName" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="调用方式" Margin="0,0,20,0" />
                            <local:MyComboBox x:Name="ComboDscInvoke" Grid.Column="1" Height="30"
                                              local:SettingService.Key="DstAiInvokeMode"
                                              ToolTip="询问 AI 时，是只把内容填进客户端，还是连发送一起做。">
                                <local:MyComboBoxItem Content="仅填充内容" local:SettingService.Value="0" IsSelected="True" />
                                <local:MyComboBoxItem Content="填充并发送" local:SettingService.Value="1" />
                            </local:MyComboBox>
                        </Grid>
                    </StackPanel>

                    <!-- 底部：状态说明 + 右下角版本 -->
                    <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LabDscState" FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                                   VerticalAlignment="Bottom" />
                        <TextBlock x:Name="LabDscVersion" Grid.Column="1" Margin="12,0,0,0" FontSize="11.5"
                                   VerticalAlignment="Bottom" TextAlignment="Right" Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </local:MyCard>

            <!-- 内存优化：回收各进程工作集，并给出高占用进程让用户自己决定结束谁 -->
            <local:MyCard Margin="0,0,0,15" Title="内存优化">
                <StackPanel Margin="25,34,25,18">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="LabMemUsage" FontSize="12.5" TextWrapping="Wrap" Text="正在读取内存占用……" />
                            <TextBlock x:Name="LabMemDetail" Margin="0,4,0,0" FontSize="11" Opacity="0.5" TextWrapping="Wrap" Text="" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                            <local:MyButton x:Name="BtnMemTrim" MinWidth="112" Height="34" Padding="13,0" Margin="0,0,10,0" Text="优化内存" ColorType="Highlight" />
                            <local:MyButton x:Name="BtnMemRefresh" MinWidth="80" Height="34" Padding="13,0" Text="刷新" />
                        </WrapPanel>
                    </Grid>
                    <TextBlock FontSize="11.5" Opacity="0.6" Margin="0,0,0,6" Text="占用较高的程序（可手动结束）" />
                    <StackPanel x:Name="PanMemList" />
                    <TextBlock x:Name="LabMemHint" Margin="0,10,0,0" FontSize="11" Opacity="0.5" TextWrapping="Wrap" Text="" />
                </StackPanel>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
