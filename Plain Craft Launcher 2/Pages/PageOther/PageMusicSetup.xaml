<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageMusicSetup" PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Margin="25,0,25,0">

            <local:MyCard Margin="0,15,0,15" Title="播放设置">
                <StackPanel Margin="25,40,25,20">
                    <Grid Margin="0,0,0,14" Height="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                            <TextBlock Text="音量" VerticalAlignment="Center" />
                            <TextBlock x:Name="LabSetupVolume" Text="50%" FontSize="11" Opacity="0.55"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <local:MySlider x:Name="SliderMusicVolume" Grid.Column="1" MaxValue="100" />
                    </Grid>
                    <local:MyCheckBox Text="随机播放" Margin="0,0,0,6" Height="22" x:Name="CheckMusicRandom" local:SettingService.Key="UiMusicRandom" />
                    <local:MyCheckBox Text="打开启动器自动开始播放" Margin="0,0,0,6" Height="22" x:Name="CheckMusicAuto" local:SettingService.Key="UiMusicAuto" />
                    <local:MyCheckBox Text="游戏启动后自动开始播放，游戏退出后自动暂停播放" Margin="0,0,0,6" Height="22" x:Name="CheckMusicStart" local:SettingService.Key="UiMusicStart" />
                    <local:MyCheckBox Text="游戏启动后自动暂停播放，游戏退出后自动开始播放" Margin="0,0,0,6" Height="22" x:Name="CheckMusicStop" local:SettingService.Key="UiMusicStop" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="音乐文件">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock x:Name="LabMusicCount" Text="当前没有音乐" FontSize="12" Opacity="0.65" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <local:MyButton x:Name="BtnMusicOpen" Text="打开文件夹" MinWidth="130" Height="32" ToolTip="把音乐放到该文件夹，启动器会播放其中的所有音乐" />
                        <local:MyButton x:Name="BtnMusicRefresh" Text="刷新列表" MinWidth="120" Height="32" Margin="10,0,0,0" ToolTip="重新扫描文件夹并刷新播放列表" />
                        <local:MyButton x:Name="BtnMusicClear" Text="清空背景音乐" MinWidth="130" Height="32" Margin="10,0,0,0" ColorType="Red" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>

            <local:MyCard x:Name="CardNeSearch" Margin="0,0,0,15" Title="搜索网易云">
                <StackPanel Margin="25,40,25,20">
                    <Grid Height="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:MyTextBox x:Name="TextNeSearch" Grid.Column="0" Height="32" HintText="输入歌名或歌单名" />
                        <local:MyButton x:Name="BtnNeSearchSong" Grid.Column="1" Text="搜歌曲" MinWidth="90" Height="32" Margin="10,0,0,0" ColorType="Highlight" />
                        <local:MyButton x:Name="BtnNeSearchList" Grid.Column="2" Text="搜歌单" MinWidth="90" Height="32" Margin="10,0,0,0" />
                    </Grid>
                    <StackPanel x:Name="PanNeSearchResult" Margin="0,12,0,0" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard x:Name="CardNetease" Margin="0,0,0,15" Title="网易云音乐">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock x:Name="LabNeState" Text="未登录" FontSize="12" Opacity="0.7" Margin="0,0,0,10" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="默认音质" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <local:MyComboBox x:Name="ComboNeQuality" Grid.Column="1" Width="150" Height="30"
                                          local:SettingService.Key="DstNeMusicLevel">
                            <local:MyComboBoxItem Content="标准（128K）" Tag="standard" />
                            <local:MyComboBoxItem Content="较高（192K）" Tag="higher" />
                            <local:MyComboBoxItem Content="极高（320K，需 VIP）" Tag="exhigh" />
                            <local:MyComboBoxItem Content="无损（需 VIP）" Tag="lossless" />
                        </local:MyComboBox>
                        <TextBlock x:Name="LabNeVip" Grid.Column="2" FontSize="11" Opacity="0.55"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <local:MyButton x:Name="BtnNeLogin" Text="登录网易云" MinWidth="130" Height="32" ColorType="Highlight" />
                        <local:MyButton x:Name="BtnNeLogout" Text="退出登录" MinWidth="110" Height="32" Margin="10,0,0,0" />
                        <local:MyButton x:Name="BtnNeRefresh" Text="刷新我的歌单" MinWidth="130" Height="32" Margin="10,0,0,0" />
                        <local:MyButton x:Name="BtnNeImportAll" Text="一键导入全部歌单" MinWidth="150" Height="32" Margin="10,0,0,0" ToolTip="把你自己所有歌单的歌曲一次性加入播放列表" />
                        <local:MyButton x:Name="BtnNeFixNames" Text="刷新歌曲信息" MinWidth="120" Height="32" Margin="10,0,0,0" ToolTip="补齐显示为“歌曲 ID”的歌名与歌手" />
                        <local:MyButton x:Name="BtnNeGrab" Text="读取登录状态" MinWidth="130" Height="32" Margin="10,0,0,0" ToolTip="在浏览器里登录完成后点这里，立刻读取会话" />
                    </StackPanel>
                    <TextBlock Text="登录会在独立的浏览器窗口里进行，成功后自动同步你的歌单（只在本机保存歌曲 ID）。"
                               FontSize="11" Opacity="0.5" TextWrapping="Wrap" Margin="0,12,0,0" />
                    <StackPanel x:Name="PanNePlaylists" Margin="0,12,0,0" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>