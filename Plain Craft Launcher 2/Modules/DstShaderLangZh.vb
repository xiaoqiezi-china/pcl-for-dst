    Private _labels As Dictionary(Of String, String) = Nothing
    Private _values As Dictionary(Of String, String) = Nothing
    Private ReadOnly InitLock As New Object

    ''' <summary>选项与分组名的对照表，首次使用时才解析。</summary>
    Private ReadOnly Property Labels As Dictionary(Of String, String)
        Get
            EnsureLoaded()
            Return _labels
        End Get
    End Property

    ''' <summary>选项值（如 Off / High）的对照表。</summary>
    Private ReadOnly Property Values As Dictionary(Of String, String)
        Get
            EnsureLoaded()
            Return _values
        End Get
    End Property

    Private Sub EnsureLoaded()
        If _labels IsNot Nothing Then Return
        SyncLock InitLock
            If _labels IsNot Nothing Then Return
            _labels = Parse(LabelsRaw)
            _values = Parse(ValuesRaw)
        End SyncLock
    End Sub

    Private Function Parse(Raw As String) As Dictionary(Of String, String)
        Dim Result As New Dictionary(Of String, String)(StringComparer.OrdinalIgnoreCase)
        For Each Line In Raw.Split({vbLf}, StringSplitOptions.RemoveEmptyEntries)
            Dim Cut As Integer = Line.IndexOf(ChrW(9))
            If Cut <= 0 Then Continue For
            Dim Key As String = Line.Substring(0, Cut).Trim()
            Dim Value As String = Line.Substring(Cut + 1).Trim()
            If Key <> "" AndAlso Value <> "" Then Result(Key) = Value
        Next
        Return Result
    End Function

    ''' <summary>取一个选项 / 分组名的中文名；查不到时返回空串。</summary>
    Public Function Translate(Text As String) As String
        If String.IsNullOrWhiteSpace(Text) Then Return ""
        Dim Result As String = ""
        If Labels.TryGetValue(Text.Trim(), Result) Then Return Result
        Return ""
    End Function

    ''' <summary>取一个选项值的中文名；查不到时返回空串。</summary>
    Public Function TranslateValue(Text As String) As String
        If String.IsNullOrWhiteSpace(Text) Then Return ""
        Dim Result As String = ""
        If Values.TryGetValue(Text.Trim(), Result) Then Return Result
        Return ""
    End Function

    ''' <summary>文本里是否已经有中文。</summary>
    Public Function HasChinese(Text As String) As Boolean
        If String.IsNullOrEmpty(Text) Then Return False
        For Each C As Char In Text
            If C >= ChrW(&H4E00) AndAlso C <= ChrW(&H9FFF) Then Return True
        Next
        Return False
    End Function

End Module
